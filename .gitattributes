# Text / EOL for VBA files
*.bas working-tree-encoding=CP932 eol=crlf
*.cls working-tree-encoding=CP932 eol=crlf
*.frm working-tree-encoding=CP932 eol=crlf

# Binary files
*.xlsm binary
*.frx binary

# Exclude developer, CI and large non-release dirs from git-archive
/.github/           export-ignore
/.vscode/           export-ignore
/.idea/             export-ignore
/logs/              export-ignore
/node_modules/      export-ignore
/ribbons/           export-ignore
/xvba_modules/      export-ignore
/xvba_unit_test/    export-ignore

# Exclude repository configuration files from git-archive
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/config.json        export-ignore
/package.json       export-ignore
